{
  "mcpServers": {
    "powerbi-report-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/home/your-user/path/to/powerbi-report-mcp/dist/index.js"
      ]
    },
    "powerbi-modeling-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/powerbi-modeling-mcp@latest",
        "--start"
      ]
    }
  }
}
